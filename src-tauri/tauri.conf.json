{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omega Zap",
  "version": "0.0.2",
  "identifier": "rocks.omegazap.desktop",
  "build": {
    "beforeDevCommand": "pnpm signal && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm signal --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Omega Zap",
        "create": false,
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Wisething",
    "copyright": "Copyright (c) 2026 Omega Zap contributors",
    "homepage": "https://github.com/joaomdsferro/omega-zap",
    "license": "MIT",
    "category": "SocialNetworking",
    "shortDescription": "WhatsApp and Signal, native",
    "longDescription": "A desktop client for WhatsApp and Signal, linked to your phone. Early test version: expect bugs and missing features.",
    "externalBin": [
      "binaries/omega-zap-signal"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/omega-zap.desktop",
        "section": "net"
      },
      "rpm": {
        "desktopTemplate": "linux/omega-zap.desktop"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
