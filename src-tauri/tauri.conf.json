{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omega Zap",
  "version": "0.0.1",
  "identifier": "rocks.omegazap.desktop",
  "build": {
    "beforeDevCommand": "pnpm signal && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm signal --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Omega Zap",
        "width": 1180,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/omega-zap-signal"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
